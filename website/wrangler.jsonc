{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nano-md",
  "account_id": "c235ff45bfd634ddf7ee1483bbd4cc9a",
  "compatibility_date": "2026-10-11",
  "keep_vars": true,
  "workers_dev": true,
  "build": {
    "command": "node stage-assets.mjs",
    "watch_dir": [
      "index.html",
      "feedback.html",
      "privacy.html",
      "analytics.js",
      "nano-md-logo.png",
      "nano-md-icon.png",
      "favicon.png",
      "mac-app-store-badge.svg",
      "robots.txt",
      "sitemap.xml",
      "worker.mjs",
      "release.json",
      "stage-assets.mjs"
    ]
  },
  "assets": {
    "directory": "../Temp/WebsiteAssets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/download",
      "/download/"
    ]
  },
  "routes": [
    {
      "pattern": "nano.thirdeyeds.com",
      "custom_domain": true
    }
  ],
  "main": "worker.mjs",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
